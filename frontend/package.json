{
  "name": "@orbitmesh/frontend",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:transcript-parity": "vitest run src/hooks/sessionTranscriptParity.test.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:ui-mock": "playwright test -c playwright.config.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "generate:realtime-types": "go run ../backend/cmd/typegen-realtime",
    "check:realtime-types": "node ./scripts/check-realtime-types.mjs",
    "test:e2e": "playwright test -c playwright.e2e.config.ts --grep @smoke",
    "test:e2e:full": "playwright test -c playwright.e2e.config.ts",
    "e2e:backend": "node ./scripts/e2e-backend.mjs",
    "e2e:frontend": "vite --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.1",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.15",
    "codemirror": "^6.0.2",
    "d3": "^7.9.0",
    "markdown-it": "^14.1.1",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.4",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.41.6",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.8.20"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@solid-primitives/utils": "^6.1.0",
    "@solidjs/testing-library": "^0.8.5",
    "@testing-library/user-event": "^14.5.2",
    "@types/d3": "^7.4.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-solid": "^0.14.0",
    "jsdom": "^23.0.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vite-plugin-solid": "^2.7.2",
    "vitest": "^1.1.4"
  }
}
